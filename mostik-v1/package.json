{
  "name": "mostik",
  "version": "0.1.0",
  "description": "lmdb-compatible put/get/remove key-value store with a storage engine written in Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "mostik.node"
  ],
  "napi": {
    "binaryName": "mostik"
  },
  "scripts": {
    "build": "napi build --release --manifest-path crates/node/Cargo.toml --output-dir . --dts native.d.ts",
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "msgpackr": "^1.11.0",
    "ordered-binary": "^1.5.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "license": "MIT"
}
